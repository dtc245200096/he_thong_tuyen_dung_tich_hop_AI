# Cấu hình Cổng máy chủ
PORT=3000
NODE_ENV=development

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tuyendung_user
DB_PASS=tuyendung_pass
DB_NAME=tuyendung_ai

# Cấu hình JWT Authentication
JWT_SECRET=super_secret_jwt_key_recruitment_ai_2026_secure
JWT_EXPIRES_IN=7d

# Giới hạn tệp tin (10 MiB = 10 * 1024 * 1024 bytes)
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,docx
UPLOAD_DIR=./uploads

# Cấu hình AI Engine
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
